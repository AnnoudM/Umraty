



"dhikr_morning_1" = "اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك النشور";
"dhikr_morning_2" = "أعوذ بكلمات الله التامات من شر ما خلق";
"dhikr_morning_3" = "بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم";

"dhikr_morning_surah_1" = "قل هو الله أحد، الله الصمد، لم يلد ولم يولد، ولم يكن له كفوًا أحد";
"dhikr_morning_surah_2" = "قل أعوذ برب الفلق، من شر ما خلق، ومن شر غاسق إذا وقب، ومن شر النفاثات في العقد، ومن شر حاسد إذا حسد";
"dhikr_morning_surah_3" = "قل أعوذ برب الناس، ملك الناس، إله الناس، من شر الوسواس الخناس، الذي يوسوس في صدور الناس، من الجنة والناس";

"dhikr_evening_1" = "اللهم بك أمسينا وبك أصبحنا وبك نحيا وبك نموت وإليك المصير";
"dhikr_evening_2" = "أعوذ بكلمات الله التامات من شر ما خلق";
"dhikr_evening_3" = "بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم";

"dhikr_evening_surah_1" = "قل هو الله أحد، الله الصمد، لم يلد ولم يولد، ولم يكن له كفوًا أحد";
"dhikr_evening_surah_2" = "قل أعوذ برب الفلق، من شر ما خلق، ومن شر غاسق إذا وقب، ومن شر النفاثات في العقد، ومن شر حاسد إذا حسد";
"dhikr_evening_surah_3" = "قل أعوذ برب الناس، ملك الناس، إله الناس، من شر الوسواس الخناس، الذي يوسوس في صدور الناس، من الجنة والناس";

"sai_title" = "تعلم السعي";
"sai_start" = "ابدأ السعي";

"sai_d_1" = "يا نورة، هل تعرفين لماذا نسعى بين الصفا والمروة؟";
"sai_d_2" = "لا يا محمد، لماذا؟";
"sai_d_3" = "لأن السعي قصة جميلة بدأت مع السيدة هاجر. كانت تبحث عن الماء لابنها إسماعيل.";
"sai_d_4" = "وماذا فعلت؟";
"sai_d_5" = "مشت بين جبل الصفا وجبل المروة سبع مرات. ثم ظهر ماء زمزم.";
"sai_d_6" = "إذًا نحن نسعى مثلها؟";
"sai_d_7" = "نعم يا نورة، نسعى مثلها في الحج والعمرة لنطيع الله ونتذكر قصتها الجميلة";
